{
  "name": "schoolsync-ingest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply schoolsync_ingest --local",
    "db:migrate:remote": "wrangler d1 migrations apply schoolsync_ingest --remote",
    "typecheck": "tsc --noEmit",
    "check:schema": "tsx scripts/schema-check.ts",
    "check": "npm run typecheck && npm run check:schema && npm run check:dates && npm run check:dedupe",
    "check:dates": "tsx scripts/date-check.ts",
    "check:dedupe": "tsx scripts/dedupe-check.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "postal-mime": "^2.2.7",
    "zod": "^4.4.3"
  }
}
